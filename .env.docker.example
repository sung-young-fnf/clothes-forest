# docker compose에서 사용하는 환경변수 (compose가 자동으로 .env를 로드).
# 실제 값을 채워 .env로 복사: cp .env.docker.example .env

JWT_SECRET=change-me-please-32-chars-or-more-secret
AUTH_SECRET=change-me-please-32-chars-or-more-secret

# Claude via AWS Bedrock (선택 — 비워두면 @claude 멘션은 안내 메시지로 fallback)
AWS_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=
SONNET_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
